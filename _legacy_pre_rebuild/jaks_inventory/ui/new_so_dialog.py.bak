        flay.addWidget(self._footer_lines)

        self._footer_subtotal = QLabel("Subtotal: $0.00")
        self._footer_subtotal.setStyleSheet("font-size: 10pt;")
        flay.addWidget(self._footer_subtotal)

        self._footer_cost = QLabel("Cost: $0.00")
        self._footer_cost.setStyleSheet("font-size: 10pt; color: #b45309;")
        flay.addWidget(self._footer_cost)

        self._footer_profit = QLabel("Profit: $0.00")
        self._footer_profit.setStyleSheet("font-size: 10pt; font-weight: bold; color: #2e7d32;")
        flay.addWidget(self._footer_profit)

        self._footer_total = QLabel("Total: $0.00")
        self._footer_total.setStyleSheet("font-size: 11pt; font-weight: bold;")
        flay.addWidget(self._footer_total)

        self._footer_margin = QLabel("Margin: —")
        self._footer_margin.setStyleSheet("font-size: 10pt;")
