    _NAV_STRUCTURE = [
        ("DASHBOARD", None, [
            ("Dashboard", DashboardScreen),
        ]),
        ("SALES", None, [
            ("Quotes", QuotesScreen),
            ("Lost Sales", LostSalesScreen),
