import html as _html_mod

# ── Supplier color palette ─────────────────────────────
_SUPPLIER_COLORS: dict[str, QColor] = {}


def _esc(text: str) -> str:
    """HTML-escape text for use in the detail drawer."""
    return _html_mod.escape(str(text)) if text else ""


def _supplier_bg(name: str) -> QColor | None:
    """Return a light pastel background for a supplier (deterministic)."""
    if not name:
        return None
    if name not in _SUPPLIER_COLORS:
        h = int(hashlib.md5(name.encode()).hexdigest()[:8], 16)
        hue = h % 360
        _SUPPLIER_COLORS[name] = QColor.fromHsl(hue, 40, 235)
    return _SUPPLIER_COLORS[name]


